{
    "name": "karnoweb/laravel-module-manager",
    "description": "A powerful module management system for Laravel with dependency resolution, tree structure, and Laravel 13 support",
    "keywords": [
        "laravel",
        "module",
        "feature-flag",
        "dependency",
        "module-manager"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Karnoweb",
            "email": "your@email.com"
        }
    ],
    "version": "13.0.0",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Karnoweb\\LaravelModuleManager\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Karnoweb\\LaravelModuleManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Karnoweb\\LaravelModuleManager\\ModuleManagerServiceProvider"
            ],
            "aliases": {
                "Module": "Karnoweb\\LaravelModuleManager\\Facades\\Module"
            }
        }
    },
    "prefer-stable": true
}
